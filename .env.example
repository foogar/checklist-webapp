# Copy to .env and fill in. Real environment variables win over this file, so
# systemd or a container can override anything here.

# Google OAuth 2.0 credentials from the Google Cloud console. The authorised
# redirect URI must be exactly PUBLIC_BASE_URL + /auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The public URL this app is reached at, with no trailing slash. Used to build
# the OAuth redirect URI. Getting this wrong produces redirect_uri_mismatch
# from Google rather than anything useful from here.
PUBLIC_BASE_URL=https://checklist.example.com

# Session signing secret. The app refuses to start while this is empty, a known
# placeholder, or shorter than 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Set to 1 when served over HTTPS. Also enables HSTS and switches the cookie to
# the __Host- prefix. Leave at 0 for local development over plain HTTP,
# otherwise you will not be able to sign in locally.
SESSION_COOKIE_SECURE=0

# Content-Security-Policy is on by default. Setting this to 0 is the escape
# hatch if a browser blocks something unexpected; the console will name the
# directive responsible.
CSP_ENABLED=1

# Development login. Set to 1 to enable /auth/dev-login, which signs you in as
# any email address with no password and no Google round trip. It creates the
# same rows the real callback does. Leave at 0 anywhere other people can reach
# the app.
DEV_AUTH_ENABLED=0

# Where the SQLite database lives. Leave unset to use checklist.db beside the
# code, which is fine for local use. On a real deployment put it somewhere
# backed up and outside the checkout:
#   DATABASE_PATH=/var/lib/checklist/checklist.db
DATABASE_PATH=

# Rate limiting. Counted per signed-in user, falling back to the client IP for
# anonymous callers, so one account cannot exhaust the household's allowance
# behind a shared router. Counters are in memory: run a single worker, or the
# effective limit multiplies by the worker count.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW=60
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW=60

# Bind address for `python main.py`. Under systemd this is passed to uvicorn
# directly; keep it on loopback and let the tunnel or reverse proxy terminate
# TLS.
HOST=127.0.0.1
PORT=8000
