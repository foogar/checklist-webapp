# Google OAuth 2.0 Credentials (Get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Session signing secret. The app refuses to start while this is empty, so
# generate a real one and paste it below:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Set to 1 when serving over HTTPS so the browser refuses to send the session
# cookie over plain HTTP. Leave at 0 for local development over HTTP, otherwise
# you will not be able to log in locally.
SESSION_COOKIE_SECURE=0

# Development login. Set to 1 to enable /auth/dev-login, which signs you in as
# any email address with no password and no Google round trip, so the app can
# be driven and tested offline. It populates the same database rows as the real
# OAuth callback. Leave at 0 everywhere other people can reach the app.
DEV_AUTH_ENABLED=0

# Where the SQLite database lives. Leave unset to use checklist.db beside the
# application code, which is correct for local use. Set an absolute path on a
# real deployment so the database sits on a persistent volume or a directory
# you back up, rather than anywhere the app happens to be installed.
#   DATABASE_PATH=/var/lib/checklist/checklist.db
DATABASE_PATH=

# Rate limiting. Requests are counted per signed-in user where possible, and
# per client IP for anonymous callers, so one account cannot exhaust the whole
# household's allowance behind a shared router. Defaults are deliberately
# generous: a person would have to be genuinely hammering the app to reach them.
# Set RATE_LIMIT_ENABLED=0 to turn limiting off entirely.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW=60
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW=60

# The service worker precaches icons and the CDN scripts, never page documents
# or API responses. Nothing to configure here; the only manual step it needs is
# bumping VERSION in static/sw.js when you change that file, which the worker
# then applies on its own.
